@@ -444,7 +445,8 @@ def link_of(row, smap) -> dict:
     """
     topic = row["section"] or smap.get(row["source_id"], "")
     url = outward(column(row, "url"))
-    return {"title": str(column(row, "headline") or column(row, "title")),
